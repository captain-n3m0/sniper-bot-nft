# Server
PORT=3000
NODE_ENV=development

# Authentication (set a long random value in production)
SESSION_SECRET=replace-with-at-least-32-random-bytes
# SIWE_DOMAIN=localhost:3000

# Persistent user config storage. In production this should point at the
# writable service data directory.
DATABASE_PATH=/var/lib/lastlap-mintgrid/app.sqlite

# Used to encrypt saved API-key config fields at rest. Keep this stable.
CONFIG_ENCRYPTION_KEY=replace-with-32-random-bytes-or-more

# Primary Alchemy RPC credential used server-side for every supported Alchemy network.
ALCHEMY_API_KEY=

# Optional OpenSea v2 API key. If omitted, the server requests and caches a temporary key.
OPENSEA_API_KEY=
# Optional funded public address used only to quote unsigned public-mint calldata
# when an execution wallet cannot cover the mint yet. It is never asked to sign.
OPENSEA_QUOTE_MINTER=

# Optional private RPCs (comma-separated). Public fallbacks are always appended.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_POLYGON=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_ROBINHOOD=
RPC_URL_SEPOLIA=

# Optional comma-separated default SeaDrop fee recipients
SEADROP_FEE_RECIPIENTS=0x0000a26b00c1F0DF003000390027140000fAa719
